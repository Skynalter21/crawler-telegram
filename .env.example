# ==============================================================================
# CONFIGURAÇÃO DO BOT DO TELEGRAM
# ==============================================================================

# 1. Token gerado pelo @BotFather no Telegram (Ex: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# 2. ID do Grupo onde o bot vai postar automaticamente (Ex: -1001234567890)
# DICA: Você pode deixar vazio, adicionar o bot no grupo e digitar /vincular lá dentro!
TELEGRAM_CHAT_ID=

# 3. Intervalo (em minutos) para o envio automático de mensagens no grupo
SCHEDULE_INTERVAL_MINUTES=60

# 4. Ativar ou desativar o envio automático periódico (true ou false)
AUTO_SEND_ENABLED=true

# 5. URL da API do Crawler de Preços (para integração futura de promoções)
CRAWLER_API_URL=http://localhost:8000

